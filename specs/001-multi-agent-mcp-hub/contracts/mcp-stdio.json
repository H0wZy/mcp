{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MCP Stdio JSON-RPC 2.0 Message Contract",
  "description": "JSON-RPC 2.0 message contracts exchanged between Host Agents and H0wZy/mcp servers over stdio",
  "type": "object",
  "required": ["jsonrpc"],
  "properties": {
    "jsonrpc": { "const": "2.0" },
    "id": { "type": ["string", "number", "null"] },
    "method": { "type": "string" },
    "params": { "type": "object" },
    "result": { "type": "object" },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "integer" },
        "message": { "type": "string" },
        "data": {}
      }
    }
  },
  "$defs": {
    "ToolCallResult": {
      "type": "object",
      "required": ["content"],
      "properties": {
        "content": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "text"],
            "properties": {
              "type": { "const": "text" },
              "text": { "type": "string" }
            }
          }
        },
        "isError": { "type": "boolean", "default": false }
      }
    }
  }
}
